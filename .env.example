# Local development only. In the Lovable preview these are injected automatically.
# Copy this file to .env and restart the dev server.

# Preferred: use the Lovable AI bridge locally (same behaviour as the preview).
LOVABLE_API_KEY=

# Alternative: call Google's Gemini API directly during local development.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
